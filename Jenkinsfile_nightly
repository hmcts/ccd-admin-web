#!groovy

properties([
    // H allow predefined but random minute see https://en.wikipedia.org/wiki/Cron#Non-standard_characters
    //CCD-3539 (Stop running Nightly builds on weekends). Original schedule was 'H 05 * * *'
    pipelineTriggers([cron('H 8 * * 1-5')])
])

@Library('Infrastructure@2.4.8')

def yarnBuilder = new uk.gov.hmcts.contino.YarnBuilder(this)
def type = 'nodejs'
def product = 'ccd'
def component = 'admin-web'

withNightlyPipeline(type, product, component) {
    enableSlackNotifications('#ccd-nightly-builds')
    enableFortifyScan()

    afterAlways('checkout') {
        sh 'yarn cache clean'
    }

    afterAlways('build') {
        yarnBuilder.yarn('setup')
    }

    afterAlways('test') {
        steps.junit allowEmptyResults: true, testResults: 'mochawesome-report/**/*result.xml'
        steps.archiveArtifacts allowEmptyArchive: true, artifacts: 'mochawesome-report/**,coverage/**'
        steps.publishHTML target: [
            allowMissing: true,
            alwaysLinkToLastBuild: true,
            keepAll: true,
            reportDir: 'mochawesome-report',
            reportFiles: 'unit.html',
            reportName: 'Unit Test Report'
        ]
        steps.publishHTML target: [
            allowMissing: true,
            alwaysLinkToLastBuild: true,
            keepAll: true,
            reportDir: 'coverage/lcov-report',
            reportFiles: 'index.html',
            reportName: 'Unit Test Coverage'
        ]
    }

    afterAlways('fortify-scan') {
        steps.archiveArtifacts allowEmptyArchive: true, artifacts: '**/Fortify Scan/**/*'
        steps.publishHTML target: [
            allowMissing: true,
            alwaysLinkToLastBuild: true,
            keepAll: true,
            reportDir: 'Fortify Scan',
            reportFiles: 'FortifyScanReport.html',
            reportName: 'Fortify Scan Report'
        ]
    }
}
