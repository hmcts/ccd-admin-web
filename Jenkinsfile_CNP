#!groovy
import uk.gov.hmcts.contino.GithubAPI

properties(
        [[$class: 'GithubProjectProperty', projectUrlStr: 'https://github.com/hmcts/ccd-admin-web'],
         pipelineTriggers([[$class: 'GitHubPushTrigger']])]
)

@Library("Infrastructure@cve-dashboard")

def product = 'ccd'
def component = 'admin-web'

class CcdNodePipelineType implements uk.gov.hmcts.contino.PipelineType, Serializable {
    def steps
    def product
    def app
    uk.gov.hmcts.contino.Builder builder

    CcdNodePipelineType(steps, product, component) {
        this.steps = steps
        this.product = product
        this.app = component

        this.steps.env.PRODUCT = product
        builder = new CcdYarnBuilder(steps)
    }
}

class CcdYarnBuilder implements uk.gov.hmcts.contino.Builder, Serializable {
    def steps
    def yarnDelegate

    CcdYarnBuilder(steps) {
        this.steps = steps
        this.yarnDelegate = new uk.gov.hmcts.contino.YarnBuilder(steps)
    }

    def build() {
        yarnDelegate.build()
    }

    def fortifyScan() {
        yarnDelegate.fortifyScan()
    }

    def test() {
        yarnDelegate.test()
    }

    def sonarScan() {
        yarnDelegate.sonarScan()
    }

    def highLevelDataSetup(String dataSetupEnvironment) {
        yarnDelegate.highLevelDataSetup(dataSetupEnvironment)
    }

    def smokeTest() {
        yarnDelegate.smokeTest()
    }

    def functionalTest() {
        yarnDelegate.functionalTest()
    }

    def e2eTest() {
        yarnDelegate.e2eTest()
    }

    def performanceTest() {
        yarnDelegate.performanceTest()
    }

    def apiGatewayTest() {
        yarnDelegate.apiGatewayTest()
    }

    def crossBrowserTest() {
        yarnDelegate.crossBrowserTest()
    }

    def crossBrowserTest(String browser) {
        yarnDelegate.crossBrowserTest(browser)
    }

    def addVersionInfo() {
        yarnDelegate.addVersionInfo()
    }

    def mutationTest() {
        yarnDelegate.mutationTest()
    }

    def fullFunctionalTest() {
        yarnDelegate.fullFunctionalTest()
    }

    def securityScan() {
        yarnDelegate.securityScan()
    }

    def techStackMaintenance() {
        yarnDelegate.techStackMaintenance()
    }

    def runProviderVerification() {
        yarnDelegate.runProviderVerification()
    }

    def runProviderVerification(pactBrokerUrl, version, publish) {
        yarnDelegate.runProviderVerification(pactBrokerUrl, version, publish)
    }

    def runConsumerTests() {
        yarnDelegate.runConsumerTests()
    }

    def runConsumerTests(pactBrokerUrl, version) {
        yarnDelegate.runConsumerTests(pactBrokerUrl, version)
    }

    def runConsumerCanIDeploy() {
        yarnDelegate.runConsumerCanIDeploy()
    }

    def setupToolVersion() {
        yarnDelegate.setupToolVersion()
    }

    def yarn(String task, String prepend = "") {
        yarnDelegate.yarn(task, prepend)
    }

    @Override
    def securityCheck() {
        try {
            steps.sh """
                set +ex
                export NVM_DIR='/home/jenkinsssh/.nvm'
                . /opt/nvm/nvm.sh || true
                nvm install
                set -ex
            """

            steps.sh label: 'corepack enable', script: '''
                mkdir -p $HOME/.local/bin
                corepack enable --install-directory $HOME/.local/bin
            ''', returnStatus: true

            steps.writeFile(file: 'yarn-audit-with-suppressions.sh', text: steps.libraryResource('uk/gov/hmcts/pipeline/yarn/yarn-audit-with-suppressions.sh'))
            steps.writeFile(file: 'prettyPrintAudit.sh', text: steps.libraryResource('uk/gov/hmcts/pipeline/yarn/prettyPrintAudit.sh'))
            steps.writeFile(file: 'transform-v4-to-v3-audit.cjs', text: steps.libraryResource('uk/gov/hmcts/pipeline/yarn/transform-v4-to-v3-audit.cjs'))

            steps.sh '''
                sed -i 's/yarn npm audit --recursive --environment production --json/yarn npm audit --all --environment production --json/g' yarn-audit-with-suppressions.sh
            '''

            this.steps.withCredentials([this.steps.usernamePassword(credentialsId: this.steps.env.GIT_CREDENTIALS_ID, passwordVariable: 'BEARER_TOKEN', usernameVariable: 'APP_ID')]) {
                steps.sh """
                    export PATH=\$HOME/.local/bin:\$PATH
                    export YARN_VERSION=\$(jq -r '.packageManager' package.json | sed 's/yarn@//' | grep -o '^[^.]*')
                    chmod +x yarn-audit-with-suppressions.sh
                    ./yarn-audit-with-suppressions.sh
                """
            }
        } finally {
            steps.sh '''
                if [ ! -s yarn-audit-result-formatted ] || ! jq -e . yarn-audit-result-formatted >/dev/null 2>&1; then
                    echo 'No valid yarn-audit-result-formatted file was produced.'
                    echo '---- yarn-audit-result ----'
                    sed -n '1,120p' yarn-audit-result || true
                    printf '%s\n' '{"type":"auditSummary","data":{"vulnerabilities":{"info":0,"low":0,"moderate":0,"high":0,"critical":0}}}' > yarn-audit-issues-result
                else
                    jq -c '. | {type: "auditSummary", data: .metadata}' yarn-audit-result-formatted > yarn-audit-issues-result-summary
                    jq -cr '.advisories| to_entries[] | {"type": "auditAdvisory", "data": { "advisory": .value }}' yarn-audit-result-formatted > yarn-audit-issues-advisories
                    cat yarn-audit-issues-result-summary yarn-audit-issues-advisories > yarn-audit-issues-result
                fi
            '''
            String issues = steps.readFile('yarn-audit-issues-result')
            String knownIssues = null
            if (steps.fileExists('yarn-audit-known-issues-result')) {
                knownIssues = steps.readFile('yarn-audit-known-issues-result')
            }
            def cveReport = yarnDelegate.prepareCVEReport(issues, knownIssues)
            new uk.gov.hmcts.pipeline.CVEPublisher(steps).publishCVEReport('node', cveReport)
        }
    }
}

def nodePipelineType = new CcdNodePipelineType(this, product, component)
def yarnBuilder = nodePipelineType.builder

// Variables to switch pipeline logic and wiring per type of build
def adminWebDevelopPr = 'PR-325' // This doesn't change frequently, but when it does, only change this value.

def secrets = [
    'ccd-${env}': [
        secret('ccd-admin-web-oauth2-client-secret', 'OAUTH2_CLIENT_SECRET'),
        secret('storage-account-primary-connection-string', 'STORAGEACCOUNT_PRIMARY_CONNECTION_STRING'),
        secret('storage-account-secondary-connection-string', 'STORAGEACCOUNT_SECONDARY_CONNECTION_STRING'),
    ],
    's2s-${env}': [
        secret('microservicekey-ccd-admin', 'IDAM_SERVICE_KEY'),
    ]
]

static LinkedHashMap<String, Object> secret(String secretName, String envVar) {
    [ $class: 'AzureKeyVaultSecret',
      secretType: 'Secret',
      name: secretName,
      version: '',
      envVariable: envVar
    ]
}

def vaultOverrides = [
    'preview': 'aat',
    'spreview': 'saat'
]

env.PUPPETEER_SKIP_CHROMIUM_DOWNLOAD = true

withPipeline(nodePipelineType, product, component) {
    onMaster {
        enableSlackNotifications('#ccd-master-builds')
    }
    if (env.BRANCH_NAME.equalsIgnoreCase(adminWebDevelopPr)) {
        enableSlackNotifications('#ccd-develop-builds')
    }
    onDemo {
        enableSlackNotifications('#ccd-demo-builds')
    }
    onPR {
        enableSlackNotifications('#ccd-pr-builds')
    }

    enableAksStagingDeployment()

    overrideVaultEnvironments(vaultOverrides)
    loadVaultSecrets(secrets)
    disableLegacyDeployment()
    enableCveDashboardIngestion()

    afterAlways('checkout') {
        sh 'yarn cache clean'
    }

    afterAlways('build') {
        yarnBuilder.yarn('setup')
    }

    afterAlways('test') {
        steps.junit allowEmptyResults: true, testResults: 'test-output/**/*result.xml'
        steps.archiveArtifacts allowEmptyArchive: true, artifacts: 'test-output/**,coverage/**'
        steps.publishHTML target: [
            allowMissing: true,
            alwaysLinkToLastBuild: true,
            keepAll: true,
            reportDir: 'test-output',
            reportFiles: 'unit.html',
            reportName: 'Unit Test Report'
        ]
        steps.publishHTML target: [
            allowMissing: true,
            alwaysLinkToLastBuild: true,
            keepAll: true,
            reportDir: 'coverage/lcov-report',
            reportFiles: 'index.html',
            reportName: 'Unit Test Coverage'
        ]
    }

    afterAlways('fortify-scan') {
        steps.publishHTML target: [
            allowMissing: true,
            alwaysLinkToLastBuild: true,
            keepAll: true,
            reportDir: 'Fortify Scan',
            reportFiles: 'FortifyScanReport.html',
            reportName: 'Fortify Scan Report'
        ]
    }

    ['preview', 'aat', 'prod', 'demo', 'perftest', 'ithc'].each { testEnvironment ->
        afterAlways("smoketest:${testEnvironment}") {
            steps.junit allowEmptyResults: true, testResults: 'smoke-output/**/*result.xml'
            steps.archiveArtifacts allowEmptyArchive: true, artifacts: 'smoke-output/**'
            steps.publishHTML target: [
                allowMissing: true,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'smoke-output',
                reportFiles: 'smoke.html',
                reportName: "Smoke Test Report - ${testEnvironment}"
            ]
        }
    }
}
